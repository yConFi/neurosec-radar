# Copy to .env for local runs. NEVER commit .env.
# In GitHub Actions these are repository Secrets with the same names.

# Supabase > Project Settings > Data API (URL) and > API Keys (secret key, sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Optional: raises NVD limit from 5 to 50 requests / 30 s (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
